diff --git a/riscv/insns/xqmac8.h b/riscv/insns/xqmac8.h
new file mode 100644
index 00000000..61a9669e
--- /dev/null
+++ b/riscv/insns/xqmac8.h
@@ -0,0 +1,53 @@
+require_rv64;
+
+/*
+ * XQMAC8
+ *
+ * rd = rd +
+ *      sum_{i=0}^{7}
+ *          int8(rs1[i]) * int8(rs2[i])
+ *
+ * rs1 : 8 packed signed INT8 values
+ * rs2 : 8 packed signed INT8 values
+ * rd  : signed INT32 accumulator
+ */
+
+reg_t packed_a = RS1;
+reg_t packed_b = RS2;
+
+/*
+ * Read old rd explicitly because rd is both
+ * source accumulator and destination.
+ */
+int64_t acc =
+    (int64_t)(int32_t)READ_REG(insn.rd());
+
+for (int i = 0; i < 8; i++)
+{
+    int8_t a =
+        (int8_t)(
+            (packed_a >> (8 * i))
+            & 0xff
+        );
+
+    int8_t b =
+        (int8_t)(
+            (packed_b >> (8 * i))
+            & 0xff
+        );
+
+    acc +=
+        (int32_t)a
+        *
+        (int32_t)b;
+}
+
+/*
+ * INT32 accumulator semantics:
+ * truncate to 32 bits and sign-extend to RV64.
+ */
+WRITE_RD(
+    sext32(
+        (uint32_t)acc
+    )
+);
diff --git a/riscv/insns/xrequant.h b/riscv/insns/xrequant.h
new file mode 100644
index 00000000..09735617
--- /dev/null
+++ b/riscv/insns/xrequant.h
@@ -0,0 +1,71 @@
+require_rv64;
+
+/*
+ * XREQUANT
+ *
+ * rs1[31:0] : signed INT32 accumulator
+ * rs2[31:0] : signed Q31 multiplier
+ *
+ * product = acc * multiplier
+ *
+ * result =
+ *   round-away-from-zero(product / 2^31)
+ *
+ * followed by signed INT8 saturation [-127, 127].
+ *
+ * Current W8A8 quantization is symmetric:
+ * zero_point = 0.
+ */
+
+int64_t acc =
+    (int64_t)(int32_t)RS1;
+
+int64_t multiplier =
+    (int64_t)(int32_t)RS2;
+
+int64_t product =
+    acc * multiplier;
+
+
+/*
+ * Round-to-nearest, ties away from zero.
+ */
+uint64_t magnitude;
+
+if (product < 0)
+    magnitude = (uint64_t)(-product);
+else
+    magnitude = (uint64_t)product;
+
+int64_t rounded =
+    (int64_t)(
+        (
+            magnitude
+            + (1ULL << 30)
+        )
+        >> 31
+    );
+
+if (product < 0)
+    rounded = -rounded;
+
+
+/*
+ * Signed INT8 saturation.
+ *
+ * We intentionally use [-127, 127], matching
+ * the current symmetric quantization reference.
+ */
+if (rounded > 127)
+    rounded = 127;
+
+if (rounded < -127)
+    rounded = -127;
+
+
+/*
+ * Sign-extend the INT8 result to XLEN=64.
+ */
+WRITE_RD(
+    (reg_t)(int64_t)(int8_t)rounded
+);
